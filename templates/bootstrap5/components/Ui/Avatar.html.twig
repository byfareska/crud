{# Somebody's picture, or the first letters of their name. Decoration next to the name it stands by. #}
{% props name = '', src = null, size = '2rem' %}
{% set initials = name|split(' ')|filter(part => part != '')|slice(0, 2)|map(part => part|first|upper)|join %}
{%- if src -%}
    <img {{ attributes.defaults({class: 'rounded-circle object-fit-cover', src: src, alt: '', loading: 'lazy', decoding: 'async', width: 32, height: 32, style: 'width: ' ~ size ~ '; height: ' ~ size, 'aria-hidden': 'true'}) }}>
{%- else -%}
    <span {{ attributes.defaults({class: 'rounded-circle bg-primary-subtle text-primary-emphasis fw-semibold d-inline-flex align-items-center justify-content-center small', style: 'width: ' ~ size ~ '; height: ' ~ size, 'aria-hidden': 'true'}) }}>{{ initials }}</span>
{%- endif -%}
