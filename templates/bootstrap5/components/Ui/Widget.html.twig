{#
    A card of the dashboard: a head with the widget's icon (in its accent) and title, the content filling the rest.
    href / link: the way to the page behind the widget, in its corner. titleHref / titleLink: the title itself a link,
    opened in a new tab. tone: a hint of the theme the widget would like ("day", "night"...); this theme draws all
    cards alike.
#}
{% props title, icon, accent = '#8b5cf6', href = null, link = null, titleHref = null, titleLink = null, tone = null %}
<article {{ attributes.defaults({class: 'card border-0 shadow-sm h-100 overflow-hidden'}) }}>
    <header class="card-header bg-transparent border-0 pt-3 d-flex align-items-center gap-2">
        {{ crud_icon(icon, '', {style: 'color: ' ~ (accent)}) }}
        <h2 class="h6 mb-0 flex-grow-1 text-truncate">
            {%- if titleHref -%}
                <a class="link-body-emphasis text-decoration-none" href="{{ titleHref }}" target="_blank" rel="noopener noreferrer" title="{{ titleLink }}">{{ title }}</a>
            {%- else -%}
                {{ title }}
            {%- endif -%}
        </h2>
        {% block head %}{% endblock %}
        {% if href %}
            <a class="link-secondary" href="{{ href }}" title="{{ link }}" aria-label="{{ link }}">{{ crud_icon('chevron-right') }}</a>
        {% endif %}
    </header>
    <div class="card-body d-flex flex-column overflow-hidden" style="min-height: 0">{% block content %}{% endblock %}</div>
</article>
