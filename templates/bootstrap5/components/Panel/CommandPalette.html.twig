{#
    The results of the palette (a live component); the keys and the dialog are the command-palette controller's. The
    controller sits on the dialog (CommandPaletteModal, outside this component), so the key of the recent items -
    of the user and the panel - is handed to it here and read from this element.
#}
<div {{ attributes.defaults({class: 'modal-content', 'data-command-palette-target': 'content', 'data-command-palette-storage-key-value': this.storageKey}) }}>
    <div class="modal-header gap-2">
        {{ crud_icon('search', 'text-body-secondary') }}
        <input
            class="form-control border-0 shadow-none px-0"
            type="text"
            placeholder="{{ 'panel.palette.placeholder'|trans }}"
            aria-label="{{ 'panel.palette.search_label'|trans }}"
            autocomplete="off"
            spellcheck="false"
            data-model="debounce(150)|query"
            data-command-palette-target="input"
            data-action="keydown.down->command-palette#next:prevent keydown.up->command-palette#previous:prevent keydown.enter->command-palette#submit:prevent"
        >
    </div>
    <div class="modal-body p-2" role="listbox">
        {% for group, actions in computed.groups %}
            <div class="small text-uppercase fw-semibold text-body-secondary px-2 pt-2 pb-1">{{ group|trans }}</div>
            <div class="list-group list-group-flush">
                {% for action in actions %}
                    {% set name = this.highlight(action.name) %}
                    <a
                        class="list-group-item list-group-item-action d-flex align-items-center gap-3 rounded border-0"
                        role="option"
                        href="{{ action.routeName ? path(action.routeName, action.routeParameters) : '#' }}"
                        {% if action.remembered %}data-key="{{ action.key }}"{% endif %}
                        {% if action.clientAction %}data-client-action="{{ action.clientAction }}"{% endif %}
                        data-command-palette-target="item"
                        data-action="click->command-palette#choose mousemove->command-palette#hover"
                    >
                        {{ crud_icon(action.icon, 'fs-5') }}
                        <span class="flex-grow-1" style="min-width: 0">
                            <span class="d-block text-truncate">{{ name.before }}{% if name.match is not empty %}<mark class="p-0">{{ name.match }}</mark>{% endif %}{{ name.after }}</span>
                            <span class="d-block small opacity-75 text-truncate">{{ action.description }}</span>
                        </span>
                        {# What Enter does with it: a command runs, a stored record (never remembered) opens, a page is gone to. #}
                        <span class="small opacity-75 text-nowrap">{{ ('panel.palette.verb.' ~ (action.clientAction ? 'run' : (action.remembered ? 'go' : 'open')))|trans }} ↵</span>
                    </a>
                {% endfor %}
            </div>
        {% else %}
            <div class="text-center text-body-secondary py-5">{{ crud_icon('search', 'd-block fs-3 mb-2') }}{{ 'panel.palette.empty'|trans({query: query}) }}</div>
        {% endfor %}
    </div>
    <div class="modal-footer justify-content-start small text-body-secondary gap-3 d-none d-md-flex">
        <span><kbd>↑</kbd> <kbd>↓</kbd> {{ 'panel.palette.navigate'|trans }}</span>
        <span><kbd>↵</kbd> {{ 'panel.palette.open'|trans }}</span>
        <span><kbd>Esc</kbd> {{ 'panel.palette.close'|trans }}</span>
        <span class="ms-auto">{{ 'panel.palette.hint_html'|trans|raw }}</span>
    </div>
</div>
