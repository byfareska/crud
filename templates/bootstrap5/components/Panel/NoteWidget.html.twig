{# A note: what is typed is kept after a pause (live model, debounced). #}
{% set text = this.text %}
{% set saved = this.saved %}
<div {{ attributes.defaults({class: 'h-100'}) }}>
    <twig:Ui:Widget :title="'panel.widget.note.title'|trans" icon="sticky" accent="#eab308">
        <textarea class="form-control flex-grow-1 border-0 bg-transparent shadow-none p-0" style="resize: none" data-model="debounce(800)|text" maxlength="5000" aria-label="{{ 'panel.widget.note.title'|trans }}"
                  placeholder="{{ 'panel.widget.note.placeholder'|trans }}">{{ text }}</textarea>
        <div class="small text-body-secondary" data-loading="show">{{ 'panel.widget.note.saving'|trans }}</div>
        {% if saved %}<div class="small text-body-secondary" data-loading="hide">{{ 'panel.widget.note.saved'|trans }}</div>{% endif %}
    </twig:Ui:Widget>
</div>
