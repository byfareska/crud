{#
    The form theme of the CRUD forms (and the filters of the lists) of this theme: Bootstrap 5's own. A theme of the
    application puts a template of this name into its directory to draw the fields otherwise.
#}
{% use 'bootstrap_5_layout.html.twig' %}

{#
    A field of files (CrudFileType): a hidden input with the JSON of its files, kept by the file-field controller -
    uploaded at once when chosen or dropped, picked in the window of the library, sorted by dragging, taken away. The
    files drawn here are those of the value; the controller draws a new one from the <template>.
#}
{%- block crud_file_widget -%}
    {%- set gallery = gallery and multiple -%}
    <div class="rounded border border-2 border-dashed p-3 {{ errors|length ? 'border-danger' : 'border-secondary-subtle' }}"
         data-controller="file-field"
         data-file-field-upload-url-value="{{ upload_url }}"
         data-file-field-token-value="{{ library_token }}"
         data-file-field-multiple-value="{{ multiple ? 'true' : 'false' }}"
         data-file-field-max-value="{{ max_files }}"
         data-action="dragover->file-field#over dragleave->file-field#leave drop->file-field#drop">
        <input type="hidden" id="{{ id }}" name="{{ full_name }}" value="{{ value }}" data-file-field-target="input"{% if disabled %} disabled{% endif %}>
        <ul class="list-unstyled mb-0 {{ gallery ? 'row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-6 g-2' : 'd-flex flex-column gap-2' }}"
            data-file-field-target="list"
            data-action="dragstart->file-field#dragStart dragover->file-field#dragOver drop->file-field#dropItem dragend->file-field#dragEnd">
            {%- for file in files -%}{{ block('crud_file_item') }}{%- endfor -%}
        </ul>
        <template data-file-field-target="template">{%- with {file: null} -%}{{ block('crud_file_item') }}{%- endwith -%}</template>
        {%- if not disabled -%}
        <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
            {%- if upload_url -%}
                <input type="file" class="d-none" accept="{{ accept }}"{% if multiple %} multiple{% endif %} data-file-field-target="picker" data-action="change->file-field#picked">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-action="file-field#choose">{{ crud_icon('upload') }} {{ (multiple ? 'file.field.upload_many' : 'file.field.upload')|trans }}</button>
            {%- endif -%}
            {%- if library_token -%}
                <button type="button" class="btn btn-sm btn-outline-secondary" data-action="file-field#browse">{{ crud_icon('collection') }} {{ 'file.field.browse'|trans }}</button>
            {%- endif -%}
            {%- if upload_url -%}<span class="small text-body-secondary">{{ 'file.field.drop'|trans }}</span>{%- endif -%}
        </div>
        {%- endif -%}
    </div>
{%- endblock crud_file_widget -%}

{# A file of a field of files; "file" is null in the <template> a new one is drawn from. #}
{%- block crud_file_item -%}
    {%- set shown = file is not null and file.image and file.url -%}
    <li class="{{ gallery ? 'col' : '' }}" data-file-field-target="item" data-ref="{{ file.ref|default('') }}" data-sig="{{ file.sig|default('') }}"{% if multiple and not disabled %} draggable="true"{% endif %}>
        <div class="position-relative {{ gallery ? 'd-flex flex-column gap-1' : 'd-flex align-items-center gap-3 rounded bg-body-tertiary p-2' }}">
            <a data-role="link" href="{{ file.url|default('#') }}" target="_blank" rel="noopener" class="d-flex align-items-center justify-content-center overflow-hidden rounded bg-body-secondary {{ gallery ? 'ratio ratio-1x1' : 'flex-shrink-0' }}"{% if not gallery %} style="width: 2.5rem; height: 2.5rem"{% endif %}>
                <img data-role="image" src="{{ shown ? file.url : '' }}" alt="" loading="lazy" class="w-100 h-100 object-fit-cover"{% if not shown %} hidden{% endif %}>
                <span data-role="icon" class="d-flex align-items-center justify-content-center fs-4 text-body-secondary"{% if shown %} hidden{% endif %}>{{ crud_icon('file-earmark') }}</span>
            </a>
            <span data-role="name" class="text-truncate small flex-grow-1" title="{{ file.name|default('') }}">{{ file.name|default('') }}</span>
            <progress data-role="progress" class="w-100" value="0" max="100" hidden></progress>
            <span data-role="error" class="small text-danger" hidden></span>
            {%- for name in meta -%}
                <input type="text" class="form-control form-control-sm" data-meta="{{ name }}" value="{{ file.meta[name]|default('') }}" placeholder="{{ ('file.field.meta.' ~ name)|trans }}" aria-label="{{ ('file.field.meta.' ~ name)|trans }}" data-action="input->file-field#sync"{% if disabled %} disabled{% endif %}>
            {%- endfor -%}
            {%- if not disabled -%}
                <button type="button" class="btn btn-sm {{ gallery ? 'btn-dark position-absolute top-0 end-0 m-1 py-0 px-1' : 'btn-link text-body-secondary' }}" data-action="file-field#remove" aria-label="{{ 'file.field.remove'|trans }}" title="{{ 'file.field.remove'|trans }}">{{ crud_icon('x-lg') }}</button>
            {%- endif -%}
        </div>
    </li>
{%- endblock crud_file_item -%}
