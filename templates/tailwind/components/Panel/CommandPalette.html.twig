{#
    The results of the palette (a live component); the keys and the dialog are the command-palette controller's. The
    controller sits on the dialog (CommandPaletteModal, outside this component), so the key of the recent items -
    of the user and the panel - is handed to it here and read from this element.
#}
<div {{ attributes.defaults({'data-command-palette-target': 'content', 'data-command-palette-storage-key-value': this.storageKey}) }}>
    <div class="flex items-center gap-3 border-b border-gray-200 px-4 dark:border-white/10">
        {{ crud_icon('search', 'text-gray-400') }}
        <input
            class="h-12 w-full bg-transparent text-base outline-none placeholder:text-gray-400"
            type="text"
            placeholder="{{ 'panel.palette.placeholder'|trans }}"
            aria-label="{{ 'panel.palette.search_label'|trans }}"
            autocomplete="off"
            spellcheck="false"
            data-model="debounce(150)|query"
            data-command-palette-target="input"
            data-action="keydown.down->command-palette#next:prevent keydown.up->command-palette#previous:prevent keydown.enter->command-palette#submit:prevent"
        >
    </div>
    <div class="max-h-[60vh] overflow-y-auto p-2" role="listbox">
        {% for group, actions in computed.groups %}
            <div class="px-2 pt-2 pb-1 text-xs font-semibold tracking-wide text-gray-500 uppercase dark:text-gray-400">{{ group|trans }}</div>
            {% for action in actions %}
                {% set name = this.highlight(action.name) %}
                <a
                    class="group flex items-center gap-3 rounded-lg px-3 py-2 data-active:bg-indigo-600 data-active:text-white"
                    role="option"
                    href="{{ action.routeName ? path(action.routeName, action.routeParameters) : '#' }}"
                    {% if action.remembered %}data-key="{{ action.key }}"{% endif %}
                    {% if action.clientAction %}data-client-action="{{ action.clientAction }}"{% endif %}
                    data-command-palette-target="item"
                    data-action="click->command-palette#choose mousemove->command-palette#hover"
                >
                    {{ crud_icon(action.icon, 'text-lg') }}
                    <span class="min-w-0 flex-1">
                        <span class="block truncate text-sm font-medium">{{ name.before }}{% if name.match is not empty %}<mark class="bg-transparent font-bold text-inherit underline">{{ name.match }}</mark>{% endif %}{{ name.after }}</span>
                        <span class="block truncate text-xs text-gray-500 group-data-active:text-white/80 dark:text-gray-400">{{ action.description }}</span>
                    </span>
                    {# What Enter does with it: a command runs, a stored record (never remembered) opens, a page is gone to. #}
                    <span class="hidden text-xs whitespace-nowrap group-data-active:inline">{{ ('panel.palette.verb.' ~ (action.clientAction ? 'run' : (action.remembered ? 'go' : 'open')))|trans }} ↵</span>
                </a>
            {% endfor %}
        {% else %}
            <div class="py-12 text-center text-sm text-gray-500 dark:text-gray-400">{{ crud_icon('search', 'mb-2 block text-2xl') }}{{ 'panel.palette.empty'|trans({query: query}) }}</div>
        {% endfor %}
    </div>
    <div class="hidden items-center gap-4 border-t border-gray-200 px-4 py-2 text-xs text-gray-500 md:flex dark:border-white/10 dark:text-gray-400">
        <span><kbd>↑</kbd> <kbd>↓</kbd> {{ 'panel.palette.navigate'|trans }}</span>
        <span><kbd>↵</kbd> {{ 'panel.palette.open'|trans }}</span>
        <span><kbd>Esc</kbd> {{ 'panel.palette.close'|trans }}</span>
        <span class="ms-auto">{{ 'panel.palette.hint_html'|trans|raw }}</span>
    </div>
</div>
