{# The way to the other panels - those the one looking may go into (byfareska_crud.scopes.<name>.role). #}
{% props panels = [] %}
{% for panel in panels %}
    {% set label = panel.label|trans %}
    <a {{ attributes.defaults({class: 'flex items-center gap-1 rounded-lg px-2 py-1.5 text-sm font-medium text-gray-700 ring-1 ring-gray-300 ring-inset hover:bg-gray-50 dark:text-gray-300 dark:ring-white/10 dark:hover:bg-white/5', href: path(panel.homeRoute), title: label}) }}>{{ crud_icon(panel.icon) }}<span class="hidden md:inline">{{ label }}</span></a>
{% endfor %}
