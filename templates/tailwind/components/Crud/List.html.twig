{#
    The list of a #[AsCrud] resource. Columns come from the declaration, filters from the list form of its driver;
    values are printed by crud_value() (@CrudTheme/crud/values.html.twig); a filter field writes to the `filters`
    LiveProp under its own name.

    A click on a row opens the preview drawer at once (data-overlay-open) and loads the record into it (live action);
    the record is part of the address (?preview=...): a page loaded with one opens the drawer by itself.
    A sortable column heading is a button: a click puts the column first in the order, a click on the first one turns
    it round, the next takes it out.
    While a request is under way, what is about to change is faded (data-loading).

    Its parts are blocks - list_toolbar, list_filters, list_above_rows, list_bulk_bar, list_table (list_columns,
    list_row, list_cell, list_row_actions, list_empty), list_footer, list_preview - the same in every theme: a theme of
    the application, or the template of a list of a resource's own (CrudList), extends this one and changes one of them:
    {% extends '@CrudTheme.tailwind/components/Crud/List.html.twig' %}, or '@CrudTheme/...' for the theme in use.
#}
{% set crud = this.definition %}
{% set operation = enum('Byfareska\\Crud\\Resource\\CrudOperation') %}
{% set result = computed.result %}
{% set actions = this.actions %}
{% set hasActions = actions is not empty %}
{% set selectable = this.selectable %}
{# "previewed": computed.preview would resolve to the preview() action. #}
{% set preview = computed.previewed %}
{# Here: inside the drawer "this" is the drawer. #}
{% set previewActions = preview ? this.recordActions(preview) : [] %}
{% set hasPreview = this.hasPreview %}
{% set drawer = 'crud-preview-' ~ crud.name %}
{# Only for what replaces the rows; "delay" keeps a fast answer from flashing. Models are matched by their full name. #}
{% set tableLoading = 'delay|model(page)' %}
{% for field in computed.filterFields %}
    {% set tableLoading = tableLoading ~ '|model(filters.' ~ field.vars.name ~ ')' %}
    {% for part in field.children|keys %}
        {% set tableLoading = tableLoading ~ '|model(filters.' ~ field.vars.name ~ '.' ~ part ~ ')' %}
    {% endfor %}
{% endfor %}
{% set tableLoading = tableLoading ~ '|addClass(opacity-50) delay|action(bulk)|addClass(opacity-50) delay|action(delete)|addClass(opacity-50) delay|action(clearFilters)|addClass(opacity-50) delay|action(sortBy)|addClass(opacity-50)' %}
{% set sortable = this.sortable %}
{% set sorting = this.sorting %}
<div {{ attributes }}>
    {% set inViewFields = this.inViewFields %}
    {% set panelFields = this.panelFields %}
    {% set filtersShown = panelFields is not empty and this.filtersShown %}
    {# The panel of the filters opens in the browser (filters-panel controller). #}
    <section class="rounded-xl border border-gray-200 bg-white shadow-xs dark:border-white/10 dark:bg-gray-900" data-scroll-anchor data-controller="filters-panel" data-filters-panel-shown-value="{{ filtersShown ? 'true' : 'false' }}" data-filters-panel-open-class="bg-gray-100 text-gray-900 ring-gray-300 dark:bg-white/20 dark:text-white dark:ring-white/20" data-filters-panel-closed-class="bg-white text-gray-900 ring-gray-300 hover:bg-gray-50 dark:bg-white/10 dark:text-white dark:ring-white/10 dark:hover:bg-white/20">
        {% set activeFilters = this.activeFilterCount %}
        {# The head of the list: how many there are, the search, the button of the filters. #}
        {% block list_toolbar %}
        <div class="flex flex-wrap items-center gap-2 border-b border-gray-200 px-4 py-3 dark:border-white/10">
            <span class="text-sm text-gray-500 dark:text-gray-400">{{ ((result.more ?? false) ? 'crud.total_more_html' : 'crud.total_html')|trans({count: result.total})|raw }}</span>
            <div class="ms-auto flex flex-wrap items-center gap-2">
                {% for field in this.searchFields %}
                    {% form_theme field with crud_form_themes() %}
                    {% set invalid = field.vars.errors|length > 0 %}
                    {% set label = field.vars.label ? field.vars.label|trans : field.vars.name|humanize %}
                    <div class="relative w-64"{% if invalid %} title="{{ field.vars.errors|map(error => error.message)|join(' ') }}"{% endif %}>
                        {{ crud_icon('search', 'pointer-events-none absolute top-1/2 start-2.5 -translate-y-1/2 text-sm text-gray-400') }}
                        {# The value as typed, not as the form normalised it (trimmed) - see CrudList::completeFilters(). #}
                        {{ form_widget(field, {value: this.filters[field.vars.name] ?? field.vars.value, attr: field.vars.attr|merge({
                            class: 'block w-full rounded-lg bg-white px-3 py-1.5 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 dark:bg-white/5 dark:text-white dark:outline-white/10 ps-8' ~ (invalid ? ' outline-red-500 dark:outline-red-400'),
                            placeholder: 'crud.search',
                            'aria-label': label,
                            'data-model': 'debounce(250)|filters.' ~ field.vars.name,
                        })}) }}
                    </div>
                {% endfor %}
                {% if panelFields is not empty %}
                    <button class="inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1.5 text-sm font-semibold shadow-xs ring-1 ring-inset disabled:opacity-50 {{ filtersShown ? 'bg-gray-100 text-gray-900 ring-gray-300 dark:bg-white/20 dark:text-white dark:ring-white/20' : 'bg-white text-gray-900 ring-gray-300 hover:bg-gray-50 dark:bg-white/10 dark:text-white dark:ring-white/10 dark:hover:bg-white/20' }}" type="button" aria-expanded="{{ filtersShown ? 'true' : 'false' }}" aria-controls="crud-filters-{{ crud.name }}" data-filters-panel-target="toggle" data-action="filters-panel#toggle">
                        {{ crud_icon('funnel') }} {{ (inViewFields is empty ? 'crud.filter.title' : 'crud.filter.more')|trans }}
                        {% if activeFilters > 0 %}<span class="rounded-full bg-indigo-600 px-1.5 text-xs text-white">{{ activeFilters }}</span>{% endif %}
                    </button>
                {% endif %}
                {# Without a filter it is gone. #}
                <button class="inline-flex items-center gap-1.5 rounded-lg bg-white px-2.5 py-1.5 text-sm font-semibold text-gray-900 shadow-xs ring-1 ring-gray-300 ring-inset hover:bg-gray-50 disabled:opacity-50 dark:bg-white/10 dark:text-white dark:ring-white/10 dark:hover:bg-white/20" type="button" data-action="live#action" data-live-action-param="clearFilters"{{ this.filtered ? '' : ' hidden disabled' }}>{{ crud_icon('x-lg') }} {{ 'crud.clear_filters'|trans }}</button>
            </div>
        </div>
        {% endblock %}

        {#
            The other filters, each under its label: those always in view (#[AsCrud] filtersInView), then those of the
            panel, hidden while it is closed. A hidden one has no field: something else sets it (#[AsCrud] listHead).
        #}
        {% block list_filters %}
        {% if inViewFields is not empty or panelFields is not empty %}
            <div class="grid grid-cols-1 gap-4 border-b border-gray-200 bg-gray-50 px-4 py-4 sm:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4 dark:border-white/10 dark:bg-white/5" id="crud-filters-{{ crud.name }}" data-filters-panel-target="box" data-always="{{ inViewFields is not empty ? 'true' : 'false' }}"{{ inViewFields is empty and not filtersShown ? ' hidden' }}>
                {% for field in inViewFields|merge(panelFields) %}
                    {% form_theme field with crud_form_themes() %}
                    {% set inPanel = loop.index > inViewFields|length %}
                    <div class="min-w-0"{% if inPanel %} data-filters-panel-target="panel"{{ filtersShown ? '' : ' hidden' }}{% endif %}>
                        {{ _self.filter_field(field, this.filters[field.vars.name] ?? null) }}
                    </div>
                {% endfor %}
            </div>
        {% endif %}
        {% endblock %}

        {# What the resource shows above its rows (#[AsCrud] listHead), e.g. the folders of the files. #}
        {% block list_above_rows %}
        {% if crud.listHead %}
            {{ component(crud.listHead, {filters: this.filters, resource: crud.name}) }}
        {% endif %}
        {% endblock %}

        {# What can be done with the records chosen (AsCrud::$bulkActions), while some are. #}
        {% block list_bulk_bar %}
        {% if selectable and (this.allMatching or this.selected is not empty) %}
            <div class="flex flex-wrap items-center gap-2 border-b border-gray-200 bg-gray-50 px-4 py-2 dark:border-white/10 dark:bg-white/5">
                <span class="me-auto text-sm font-semibold">
                    {{- (this.allMatching ? 'crud.all_matching_selected' : 'crud.selected')|trans({count: this.selectedCount(result)}) -}}
                    {# The whole page chosen, and the filters match more: all of them, on every page. #}
                    {% if this.canSelectAllMatching(result) %}
                        <button class="ms-2 font-semibold text-indigo-600 hover:underline dark:text-indigo-400" type="button" data-action="live#action" data-live-action-param="selectAllMatching">{{ 'crud.select_all_matching'|trans({count: result.total}) }}</button>
                    {% endif %}
                </span>
                {% for action in this.bulkButtons(result) %}{{ crud_action(action, 'bar') }}{% endfor %}
                <button class="px-2 py-2 text-sm font-semibold text-gray-600 hover:text-gray-900 dark:text-gray-300 dark:hover:text-white" type="button" data-action="live#action" data-live-action-param="clearSelection">{{ 'crud.clear_selection'|trans }}</button>
            </div>
        {% endif %}
        {% endblock %}

        {# The table of the records; its rows and cells are blocks of their own. #}
        {% block list_table %}
        <div class="overflow-x-auto" data-loading="{{ tableLoading }}">
            <table class="min-w-full divide-y divide-gray-200 text-sm dark:divide-white/10">
                <thead class="text-start">
                    <tr>
                        {% if selectable %}
                            {% set pageSelection = this.pageSelection(result) %}
                            <th class="w-px px-4 py-3"><input class="size-4 accent-indigo-600" type="checkbox" aria-label="{{ 'crud.select_page'|trans }}"{{ pageSelection ? ' checked' }} data-controller="indeterminate" data-indeterminate-mixed-value="{{ pageSelection is null ? 'true' : 'false' }}" data-action="change->live#action" data-live-action-param="selectPage"></th>
                        {% endif %}
                        {# The headings of the columns. #}
                        {% block list_columns %}
                        {% for column in crud.columns %}
                            {% if column.field in sortable %}
                                {% set order = sorting[column.field] ?? null %}
                                {# aria-sort belongs to one column only: the one the list is ordered by first. #}
                                <th class="px-4 py-3 font-semibold" aria-sort="{{ order and (order.place ?? 1) == 1 ? (order.descending ? 'descending' : 'ascending') : 'none' }}">
                                    <button class="inline-flex items-center gap-1 font-semibold whitespace-nowrap {{ order ? 'text-indigo-600 dark:text-indigo-400' : 'hover:text-indigo-600 dark:hover:text-indigo-400' }}" type="button" title="{{ 'crud.sort_tip'|trans }}" data-action="live#action" data-live-action-param="sortBy" data-live-field-param="{{ column.field }}">{{ column.label|trans }} {{ crud_icon(order ? (order.descending ? 'arrow-down' : 'arrow-up') : 'arrow-down-up opacity-40') }}{% if order and order.place %}<sup>{{ order.place }}</sup>{% endif %}</button>
                                </th>
                            {% else %}
                                <th class="px-4 py-3 font-semibold whitespace-nowrap">{{ column.label|trans }}</th>
                            {% endif %}
                        {% endfor %}
                        {% endblock %}
                        {% if hasActions %}<th class="px-4 py-3"><span class="sr-only">{{ 'crud.actions'|trans }}</span></th>{% endif %}
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 dark:divide-white/5">
                    {% for item in result.items %}
                        {% set id = this.idOf(item) %}
                        {# On every data cell, not on the row: the actions menu must not open the preview. #}
                        {% set openPreview = hasPreview ? {role: 'button', 'data-overlay-open': drawer, 'data-action': 'click->live#action', 'data-live-action-param': 'preview', 'data-live-id-param': id} : {} %}
                        {# What the RecordRow services of the resource add: a class, data attributes. #}
                        {# The row of a record: "item", "id". #}
                        {% block list_row %}
                        {% set row = this.rowAttributes(item, result) %}
                        <tr id="{{ crud.name }}-{{ id }}" class="hover:bg-gray-50 dark:hover:bg-white/5{{ row.class is defined ? ' ' ~ row.class }}"{{ crud_attrs(row|filter((value, name) => name != 'class')) }}>
                            {% if selectable %}
                                <td class="w-px px-4 py-2.5"><input class="size-4 accent-indigo-600" type="checkbox" value="{{ id }}" aria-label="{{ 'crud.select'|trans }}"{{ this.allMatching or id in this.selected ? ' checked' }}{{ this.allMatching ? ' disabled' }} data-model="selected[]"></td>
                            {% endif %}
                            {% for column in crud.columns %}
                                {# The cell of a column: "column", "value", "item", "id", "loop" (the first leads to the record). #}
                                {% block list_cell %}
                                {% set value = item[column.field] ?? null %}
                                <td class="px-4 py-2.5{{ openPreview is not empty ? ' cursor-pointer' }}"{{ crud_attrs(openPreview) }}>
                                    {# Captured, not assigned: an assignment would forget that the output is HTML already. #}
                                    {% set printed %}{{ crud_value(crud, column, value, item, 'list') }}{% endset %}
                                    {% if loop.first and openPreview is not empty %}
                                        {# The keyboard's way to the preview: its click is handled by the cell. #}
                                        <button class="text-start font-semibold hover:text-indigo-600 dark:hover:text-indigo-400" type="button">{{ printed }}</button>
                                    {% elseif loop.first and crud.can(operation.Read) %}
                                        <a class="font-semibold hover:text-indigo-600 dark:hover:text-indigo-400" href="{{ path(crud.route('show'), {id: id}) }}">{{ printed }}</a>
                                    {% elseif loop.first and crud.can(operation.Update) %}
                                        <a class="font-semibold hover:text-indigo-600 dark:hover:text-indigo-400" href="{{ path(crud.route('edit'), {id: id}) }}">{{ printed }}</a>
                                    {% else %}
                                        {{ printed }}
                                    {% endif %}
                                </td>
                                {% endblock %}
                            {% endfor %}
                            {% block list_row_actions %}
                            {% if hasActions %}
                                {# Drawn by the theme (@CrudTheme/crud/actions.html.twig) or by an action's own component. #}
                                {% set rowActions = this.rowActions(item, result) %}
                                {% set menu = rowActions|filter(action => not action.inline) %}
                                <td class="w-px px-4 py-2.5 text-end whitespace-nowrap">
                                    <div class="inline-flex items-center gap-1">
                                    {% for action in rowActions|filter(action => action.inline) %}
                                        {{ crud_action(action, 'row') }}
                                    {% endfor %}
                                    {% if menu is not empty %}
                                        <details class="inline-block text-start" data-dropdown data-controller="dropdown" data-action="toggle->dropdown#toggle keydown.esc->dropdown#escape">
                                            <summary class="inline-flex items-center justify-center rounded-lg p-1.5 ring-1 ring-inset ring-gray-300 hover:bg-gray-100 dark:ring-white/15 dark:hover:bg-white/10 cursor-pointer list-none text-gray-500 dark:text-gray-400 [&::-webkit-details-marker]:hidden" aria-label="{{ 'crud.actions'|trans }}">{{ crud_icon('three-dots') }}</summary>
                                            <ul class="z-50 min-w-48 rounded-lg bg-white py-1 shadow-lg ring-1 ring-black/5 dark:bg-gray-800 dark:ring-white/10" data-dropdown-target="menu" data-action="click->dropdown#choose">
                                                {% for action in menu %}
                                                    <li>{{ crud_action(action, 'menu') }}</li>
                                                {% endfor %}
                                            </ul>
                                        </details>
                                    {% endif %}
                                    </div>
                                </td>
                            {% endif %}
                            {% endblock %}
                        </tr>
                        {% endblock %}
                    {% endfor %}
                </tbody>
            </table>
            {% block list_empty %}
            {% if result.items is empty %}
                <twig:Ui:EmptyState :icon="crud.icon" :title="'crud.empty'|trans" />
            {% endif %}
            {% endblock %}
        </div>
        {% endblock %}

        {# Which records of all, the size of a page, the pages. #}
        {% block list_footer %}
        <div class="flex flex-wrap items-center gap-2 border-t border-gray-200 px-4 py-3 dark:border-white/10">
            {# Which records of all: "46–60 of 2 001" on the third page of fifteen. #}
            {% set from = (result.page - 1) * result.perPage + 1 %}
            <span class="me-auto text-sm text-gray-500 dark:text-gray-400">{{ ((result.more ?? false) ? 'ui.list.shown_more_html' : 'ui.list.shown_html')|trans({shown: result.items|length, from: from, to: from + result.items|length - 1, total: result.total})|raw }}</span>
            {% if this.pageSizes|length > 1 %}
                <label class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400">
                    {{ 'ui.list.per_page'|trans }}
                    <select class="rounded-lg bg-white py-1.5 pe-8 ps-3 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 dark:bg-white/5 dark:text-white dark:outline-white/10" id="{{ crud.name }}-per-page" data-controller="live-set" data-live-set-model-value="perPage" data-live-set-keep-value="true" data-action="change->live-set#now">
                        {% for size in this.pageSizes %}
                            <option value="{{ size }}"{{ size == this.pageSize ? ' selected' }}>{{ size }}</option>
                        {% endfor %}
                    </select>
                </label>
            {% endif %}
            <twig:Ui:Pagination :page="result.page" :pageCount="result.pageCount" />
        </div>
        {% endblock %}
    </section>

    {# The preview drawer of a record. #}
    {% block list_preview %}
    {% if hasPreview %}
        <twig:Ui:Offcanvas
            :id="drawer"
            :title="preview.title ?? crud.key('title')|trans"
            :subtitle="crud.key('title')|trans"
            data-action="crud-preview:close@window->overlay#close overlay:hidden->live#action"
            data-live-action-param="closePreview"
            data-overlay-open-value="{{ preview ? 'true' : 'false' }}"
            data-loading="action(preview)|addClass(opacity-50)"
        >
            {% if preview %}
                <twig:Crud:Details :layout="crud_details_layout(crud, preview, true)" />
            {% else %}
                {# Opened for the first time: the record is still on its way, show where its values will be. #}
                <div class="animate-pulse">
                    {% for column in crud.details ?: crud.columns %}
                        <dl class="mb-4"><dt class="text-sm text-gray-500 dark:text-gray-400">{{ column.label|trans }}</dt><dd class="mt-1 h-4 w-1/2 rounded bg-gray-200 dark:bg-white/10"></dd></dl>
                    {% endfor %}
                </div>
            {% endif %}

            <twig:block name="footer">
                {# Drawn by the theme, the main one (edit) last. #}
                {% for action in previewActions|filter(action => not action.primary)|merge(previewActions|filter(action => action.primary)) %}
                    {{ crud_action(action, 'bar') }}
                {% endfor %}
                <button class="inline-flex items-center gap-1.5 rounded-lg bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-xs ring-1 ring-gray-300 ring-inset hover:bg-gray-50 disabled:opacity-50 dark:bg-white/10 dark:text-white dark:ring-white/10 dark:hover:bg-white/20 ms-auto" type="button" commandfor="{{ drawer }}" command="close">{{ 'ui.action.close'|trans }}</button>
            </twig:block>
        </twig:Ui:Offcanvas>
    {% endif %}
    {% endblock %}
</div>

{#
    A filter under its label. "typed": its value in `filters` - as typed, not as the form normalised it (trimmed), see
    CrudList::completeFilters().
#}
{% macro filter_field(field, typed) %}
    {% if 'crud_comparison' in field.vars.block_prefixes %}
        {{ _self.comparison_filter(field, typed) }}
    {% else %}
        {% set invalid = field.vars.errors|length > 0 %}
        {# The label of the DTO's form field: a translation key. #}
        {% set label = field.vars.label ? field.vars.label|trans : field.vars.name|humanize %}
        <label class="mb-1 block text-xs font-medium text-gray-600 dark:text-gray-400" for="{{ field.vars.id }}">{{ label }}</label>
        {{ form_widget(field, {value: typed ?? field.vars.value, attr: field.vars.attr|merge({
            class: 'block w-full rounded-lg bg-white px-3 py-1.5 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 dark:bg-white/5 dark:text-white dark:outline-white/10' ~ (invalid ? ' outline-red-500 dark:outline-red-400'),
            'data-model': 'debounce(250)|filters.' ~ field.vars.name,
        })}) }}
        {% if invalid %}<p class="mt-1 text-xs text-red-600 dark:text-red-400">{{ field.vars.errors|map(error => error.message)|join(' ') }}</p>{% endif %}
    {% endif %}
{% endmacro %}

{#
    A filter that says how it compares (ComparisonType): its label with the choice of the comparison next to it - none
    with one - and under them the value or, for "between", where the range starts and ends. Each part writes to
    `filters.<name>.<part>`; the parts are null until chosen (CrudList::completeFilters()), and then show what the form
    makes of them. "typed": the filter in `filters`.
#}
{% macro comparison_filter(field, typed) %}
    {% set typed = typed is iterable ? typed : {} %}
    {% set comparison = typed.comparison ?? field.comparison.vars.value %}
    {% set between = comparison == 'between' and field.to is defined %}
    {# Several values at once (in, not_in), or none to type (empty, filled) - the application's own ways among them. #}
    {% set many_comparisons = field.vars.many_comparisons ?? ['in', 'not_in'] %}
    {% set presence_comparisons = field.vars.presence_comparisons ?? ['empty', 'filled'] %}
    {% set many = comparison in many_comparisons and field.values is defined %}
    {% set presence = comparison in presence_comparisons %}
    {% set invalid = field.vars.errors|length > 0 %}
    {% set label = field.vars.label ? field.vars.label|trans : field.vars.name|humanize %}
    {% set model = 'filters.' ~ field.vars.name ~ '.' %}
    {% set dates = ('date' in field.value.vars.block_prefixes or 'datetime' in field.value.vars.block_prefixes) and (field.value.vars.widget ?? null) == 'single_text' %}
    {# A choice of how it compares is made in the browser, the server asked only when there is a value (comparison controller). #}
    <div data-controller="comparison" data-comparison-many-value="{{ many_comparisons|json_encode }}" data-comparison-presence-value="{{ presence_comparisons|json_encode }}">
        <div class="mb-1 flex items-center justify-between gap-2">
            <label class="truncate text-xs font-medium text-gray-600 dark:text-gray-400" for="{{ field.value.vars.id ~ (dates ? '_dates') }}">{{ label }}</label>
            {% if field.comparison.vars.choices|length > 1 %}
                {{ form_widget(field.comparison, {value: comparison, attr: {
                    class: 'cursor-pointer rounded bg-transparent py-0 text-xs font-medium text-gray-600 focus:outline-2 focus:outline-indigo-600 dark:text-gray-400 dark:[&>option]:bg-gray-900',
                    'aria-label': 'crud.filter.comparison.label'|trans({field: label}),
                    'data-model': 'norender|' ~ model ~ 'comparison',
                    'data-comparison-target': 'select',
                    'data-action': 'comparison#change',
                }}) }}
            {% endif %}
        </div>
        {% if dates %}
            <div data-comparison-target="single"{{ many or presence ? ' hidden' }}>{{ _self.date_filter(field, typed, between, label, model, invalid) }}</div>
        {% else %}
            <div data-comparison-target="single"{{ many or presence ? ' hidden' }}>
            <div class="flex items-center gap-1">
                {% for part in field.to is defined ? ['value', 'to'] : ['value'] %}
                    {% set child = field[part] %}
                    {% if part == 'to' %}<span class="text-gray-400" data-comparison-target="between"{{ between ? '' : ' hidden' }}>–</span>{% endif %}
                    {% set hint = (part == 'value' ? 'crud.filter.from' : 'crud.filter.to')|trans %}
                    {# The value as typed, not as the form normalised it (trimmed) - see CrudList::completeFilters(). #}
                    {{ form_widget(child, {value: typed[part] ?? child.vars.value, attr: child.vars.attr|merge({
                        class: 'block w-full rounded-lg bg-white px-3 py-1.5 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 dark:bg-white/5 dark:text-white dark:outline-white/10 min-w-0 flex-1' ~ (invalid ? ' outline-red-500 dark:outline-red-400'),
                        'aria-label': part == 'to' ? label ~ ' – ' ~ hint : label,
                        'data-model': 'debounce(250)|' ~ model ~ part,
                        'data-comparison-target': 'value' ~ (field.to is defined ? ' hinted') ~ (part == 'to' ? ' between'),
                        'data-hint': hint,
                    })|merge(between ? {placeholder: hint, title: hint} : {})|merge(part == 'to' and not between ? {hidden: 'hidden'} : {})}) }}
                {% endfor %}
            </div>
            </div>
        {% endif %}
        {% if field.values is defined %}
            {# The values of "is one of" / "is none of": the same field, several of it chosen - hidden by a wrapper, as an
               autocomplete (Tom Select) puts its own field next to the select. #}
            <div data-comparison-target="many"{{ many ? '' : ' hidden' }}>
            {{ form_widget(field.values, {attr: field.values.vars.attr|merge({
                class: 'block w-full rounded-lg bg-white px-3 py-1.5 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 dark:bg-white/5 dark:text-white dark:outline-white/10' ~ (invalid ? ' outline-red-500 dark:outline-red-400'),
                'aria-label': label,
                'data-model': model ~ 'values',
            })}) }}
            </div>
        {% endif %}
        {% if invalid %}<p class="mt-1 text-xs text-red-600 dark:text-red-400">{{ field.vars.errors|map(error => error.message)|join(' ') }}</p>{% endif %}
    </div>
{% endmacro %}

{#
    A date, or "from - to" for the comparison "between", picked in a calendar (date-range controller): the dates go to
    hidden inputs bound to the filter, the field shows them in words. A date and time (DateTimeType) gets the time too.
#}
{% macro date_filter(field, typed, between, label, model, invalid) %}
    {% set from = typed.value ?? field.value.vars.value %}
    {% set to = field.to is defined ? typed.to ?? field.to.vars.value : '' %}
    {% set range = 'crud.filter.from'|trans ~ ' — ' ~ 'crud.filter.to'|trans %}
    {% set placeholder = between ? range : '' %}
    <div class="relative" data-controller="date-range" data-comparison-target="dates" data-placeholder="{{ range }}" data-date-range-range-value="{{ between ? 'true' : 'false' }}" data-date-range-from-value="{{ from }}" data-date-range-to-value="{{ to }}" data-date-range-locale-value="{{ app.request.locale }}" data-date-range-placeholder-value="{{ placeholder }}" data-date-range-time-value="{{ 'datetime' in field.value.vars.block_prefixes ? 'true' : 'false' }}" data-date-range-labels-value="{{ {from: 'crud.filter.from'|trans, to: 'crud.filter.to'|trans, time: 'crud.filter.time'|trans, dialog: label}|json_encode }}">
        {{ form_widget(field.value, {type: 'hidden', value: from, attr: {'data-model': model ~ 'value', 'data-date-range-target': 'from', 'data-comparison-target': 'value'}}) }}
        {% if field.to is defined %}{{ form_widget(field.to, {type: 'hidden', value: to, attr: {'data-model': model ~ 'to', 'data-date-range-target': 'to', 'data-comparison-target': 'value'}}) }}{% endif %}
        {{ crud_icon('calendar3', 'pointer-events-none absolute top-1/2 start-2.5 -translate-y-1/2 text-xs text-gray-400') }}
        <input type="text" readonly id="{{ field.value.vars.id }}_dates" class="block w-full cursor-pointer truncate rounded-lg bg-white py-1.5 pe-8 ps-8 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 dark:bg-white/5 dark:text-white dark:outline-white/10{{ invalid ? ' outline-red-500 dark:outline-red-400' }}" placeholder="{{ placeholder }}" aria-label="{{ label }}" aria-haspopup="dialog" aria-expanded="false" autocomplete="off" data-live-ignore data-date-range-target="display" data-action="click->date-range#toggle keydown->date-range#key">
        <button type="button" class="absolute top-1/2 end-1.5 -translate-y-1/2 cursor-pointer rounded p-1 text-xs text-gray-400 hover:text-gray-700 dark:hover:text-gray-200" aria-label="{{ 'crud.filter.clear'|trans }}" title="{{ 'crud.filter.clear'|trans }}" data-date-range-target="clear" data-action="date-range#clear"{{ from or to ? '' : ' hidden' }}>{{ crud_icon('x-lg') }}</button>
    </div>
{% endmacro %}
