{#
    The add / edit form of a #[AsCrud] resource. Fields are synced without re-rendering (norender), so nothing is
    validated - and no password field is emptied - before the form is saved. Files chosen in the form are sent with
    the save (files|save). The focus starts in the first field and, after a refused save, moves to the first field
    with an error (focus-first). The fields are drawn by the layout of the resource (crud_layout); what it does not
    place comes after it.

    Its parts are blocks - form_head, form_actions, form_fillers, form_fields - the same in every theme: a theme of the
    application, or the template of a form of a resource's own (CrudForm), extends this one and changes one of them.
    The title row (form_head) is drawn here, not by the page, so the save buttons in it (form_actions) are part of the
    component; they reach the form by its id.
#}
{% form_theme form with crud_form_themes() %}
{% set crud = this.definition %}
{% set layout = this.layout %}
{% set operation = enum('Byfareska\\Crud\\Resource\\CrudOperation') %}
{% set form_id = form.vars.id %}
{% set id = this.id %}
{% set actions = this.actions %}
{% set save_actions %}
    {% block form_actions %}
    {# The other buttons of AsCrud "afterSave": they save, then lead elsewhere (AfterSave). #}
    {% for then in this.saveChoices %}
        <button class="inline-flex items-center gap-1.5 rounded-lg bg-white px-3 py-2 text-sm font-semibold text-indigo-700 shadow-xs ring-1 ring-indigo-300 ring-inset hover:bg-indigo-50 disabled:opacity-50 dark:bg-white/10 dark:text-indigo-300 dark:ring-indigo-400/40 dark:hover:bg-white/20" type="button" data-action="live#action:prevent" data-live-action-param="files|save" data-live-then-param="{{ then.value }}" data-loading="addAttribute(disabled)">{{ ('ui.action.save_' ~ then.value)|trans }}</button>
    {% endfor %}
    {# The buttons of the application's own (CrudSaveButton): they save, then lead where they say. #}
    {% for button in this.saveButtons %}
        <button class="inline-flex items-center gap-1.5 rounded-lg bg-white px-3 py-2 text-sm font-semibold text-indigo-700 shadow-xs ring-1 ring-indigo-300 ring-inset hover:bg-indigo-50 disabled:opacity-50 dark:bg-white/10 dark:text-indigo-300 dark:ring-indigo-400/40 dark:hover:bg-white/20" type="button" data-action="live#action:prevent" data-live-action-param="files|save" data-live-then-param="{{ button.name }}" data-loading="addAttribute(disabled)">{{ button.label|trans }}</button>
    {% endfor %}
    <button class="inline-flex items-center gap-1.5 rounded-lg bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500 disabled:opacity-50 dark:bg-indigo-500 dark:hover:bg-indigo-400" type="submit" form="{{ form_id }}" data-loading="addAttribute(disabled)">{{ crud_icon('check-lg') }} {{ 'ui.action.save'|trans }}</button>
    {% endblock %}
{% endset %}
<div {{ attributes.defaults({'data-controller': 'focus-first show-if'}) }}>
    {% block form_head %}
    {% set title = crud.key(id is null ? 'new' : 'edit')|trans %}
    {# The way out of the form, with the same keys as on the details page; the save buttons last, on the far side. #}
    <twig:Ui:PageHead :title="title" :meta="crud.key('title')|trans">
        <twig:block name="actions">
            {# One's own record (AsCrud::$own) has no list: the way out is its details, below. #}
            {% if not (crud.own and crud.can(operation.Read)) %}
                <a class="inline-flex items-center gap-1.5 rounded-lg bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-xs ring-1 ring-gray-300 ring-inset hover:bg-gray-50 disabled:opacity-50 dark:bg-white/10 dark:text-white dark:ring-white/10 dark:hover:bg-white/20" href="{{ crud_return_url(crud, id) }}">{{ crud_icon('arrow-left') }} {{ crud.own ? 'ui.action.cancel'|trans : 'crud.action.list'|trans }}</a>
            {% endif %}
            {# What can be done with the record - see RecordAction: its details, deleting it... #}
            {% for action in actions %}
                {{ crud_action(action, 'bar') }}
            {% endfor %}
            {{ save_actions }}
        </twig:block>
    </twig:Ui:PageHead>
    {% endblock %}
    {# Something pasted fills the fields in (CrudFormFiller); one the layout places is drawn there instead. #}
    {% block form_fillers %}
    {% for name, filler in layout.fillers|filter((filler, name) => not layout.places(name)) %}
        {{ include('@CrudTheme/crud/_filler.html.twig', {filler: filler, crud: crud}) }}
    {% endfor %}
    {% endblock %}
    <section class="p-6 rounded-xl border border-gray-200 bg-white shadow-xs dark:border-white/10 dark:bg-gray-900">
            {{ form_start(form, {attr: {
                id: form_id,
                novalidate: 'novalidate',
                'data-model': 'norender|*',
                'data-action': 'live#action:prevent',
                'data-live-action-param': 'files|save',
            }}) }}
                {% block form_fields %}
                {{ form_errors(form) }}
                {{ crud_layout(layout) }}
                {{ form_rest(form) }}
                {% endblock %}
            {{ form_end(form) }}
    </section>
</div>
