{# A drawer (<dialog> at the edge). Open it with <button commandfor="id" command="show-modal">; blocks: content, footer. #}
{% props id, title, subtitle = null, placement = 'end' %}
<dialog {{ attributes.defaults({
    class: 'fixed inset-y-0 m-0 h-dvh max-h-none w-full max-w-md ' ~ (placement == 'start' ? 'start-0 end-auto' : 'end-0 start-auto') ~ ' flex-col bg-white p-0 text-gray-900 shadow-xl open:flex backdrop:bg-gray-950/50 dark:bg-gray-900 dark:text-gray-100',
    id: id,
    closedby: 'any',
    'aria-labelledby': id ~ '-title',
    'data-controller': 'overlay',
}) }}>
    <div class="flex items-start gap-3 border-b border-gray-200 p-4 dark:border-white/10">
        <div class="min-w-0 flex-1">
            <h2 class="truncate text-lg font-semibold" id="{{ id }}-title">{{ title }}</h2>
            {% if subtitle %}<div class="text-sm text-gray-500 dark:text-gray-400">{{ subtitle }}</div>{% endif %}
        </div>
        <button type="button" class="rounded-lg p-1.5 text-gray-500 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-white/10" commandfor="{{ id }}" command="close" aria-label="{{ 'ui.action.close'|trans }}">{{ crud_icon('x-lg') }}</button>
    </div>
    <div class="flex-1 overflow-y-auto p-4">{% block content %}{% endblock %}</div>
    {% set footer %}{% block footer %}{% endblock %}{% endset %}
    {% if footer|trim is not empty %}
        <div class="flex flex-wrap gap-2 border-t border-gray-200 p-4 dark:border-white/10">{{ footer }}</div>
    {% endif %}
</dialog>
