{#
    The one dialog of a page that asks "are you sure?", filled and opened by the confirm controller of the element that
    needs the answer. The focus starts on "cancel", ← / → walk between the buttons, Esc answers no.
#}
{% props id = 'confirm-dialog' %}
<twig:Ui:Modal :id="id" size="sm" role="alertdialog" aria-labelledby="{{ id }}-message" aria-describedby="{{ id }}-hint" {{ ...attributes }}>
    <div class="p-5">
        <div class="mb-1 font-semibold" id="{{ id }}-message" data-confirm-dialog="message"></div>
        <div class="text-sm text-gray-500 dark:text-gray-400" id="{{ id }}-hint" data-confirm-dialog="hint"></div>
        {# What the question asks besides "yes" (ConfirmInput): a text, a number, a day or a choice. #}
        <div class="mt-3" data-confirm-dialog="field" hidden>
            <label class="mb-1 block text-sm font-medium" data-confirm-dialog="label"></label>
            <textarea class="block w-full rounded-md border-0 px-3 py-1.5 text-sm ring-1 ring-gray-300 ring-inset dark:bg-white/5 dark:ring-white/10" id="{{ id }}-text" rows="2" data-confirm-dialog="text"></textarea>
            {# A number, a day or a line (ConfirmInput type), its kind set by the confirm controller. #}
            <input class="block w-full rounded-md border-0 px-3 py-1.5 text-sm ring-1 ring-gray-300 ring-inset dark:bg-white/5 dark:ring-white/10" id="{{ id }}-input" data-confirm-dialog="input" hidden>
            <select class="block w-full rounded-md border-0 px-3 py-1.5 text-sm ring-1 ring-gray-300 ring-inset dark:bg-white/5 dark:ring-white/10" id="{{ id }}-choice" data-confirm-dialog="choice" hidden></select>
        </div>
    </div>
    <div class="flex justify-end gap-2 bg-gray-50 px-5 py-3 dark:bg-white/5" data-action="keydown->overlay#walk">
        <button type="button" class="rounded-lg bg-white px-3 py-2 text-sm font-semibold shadow-xs ring-1 ring-gray-300 ring-inset hover:bg-gray-50 dark:bg-white/10 dark:ring-white/10 dark:hover:bg-white/20" commandfor="{{ id }}" command="close" data-overlay-target="autofocus">{{ 'ui.action.cancel'|trans }}</button>
        <button type="button" class="rounded-lg bg-red-600 px-3 py-2 text-sm font-semibold text-white shadow-xs hover:bg-red-500" commandfor="{{ id }}" command="close" data-confirm-dialog="accept" data-confirm-dialog-label="{{ 'ui.action.confirm'|trans }}">{{ 'ui.action.confirm'|trans }}</button>
    </div>
</twig:Ui:Modal>
