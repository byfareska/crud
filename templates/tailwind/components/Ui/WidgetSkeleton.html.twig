    <div class="h-3 w-2/5 rounded bg-gray-200 dark:bg-white/10"></div>
    <div class="h-6 w-3/5 rounded bg-gray-200 dark:bg-white/10"></div>
    <div class="h-3 w-1/2 rounded bg-gray-200 dark:bg-white/10"></div>
</div>
