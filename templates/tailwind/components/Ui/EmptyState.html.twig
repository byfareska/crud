{% props icon, title %}
<section {{ attributes.defaults({class: 'px-4 py-12 text-center text-gray-500 dark:text-gray-400'}) }}>
    {{ crud_icon(icon, 'mb-2 block text-4xl') }}
    <div class="font-semibold text-gray-900 dark:text-gray-100">{{ title }}</div>
    <p>{% block content %}{% endblock %}</p>
</section>
