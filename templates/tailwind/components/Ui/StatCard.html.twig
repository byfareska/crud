{# A KPI tile. trend: up | down | flat; accent: any CSS colour of its icon. #}
{% props icon, label, value, caption = null, trend = 'flat', accent = null %}
<div {{ attributes.defaults({class: 'h-full rounded-xl border border-gray-200 bg-white p-4 shadow-xs dark:border-white/10 dark:bg-gray-900'}) }}>
    <div class="mb-1 flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400">
        {{ crud_icon(icon, '', accent ? {style: 'color: ' ~ accent} : {}) }} {{ label }}
    </div>
    <div class="text-2xl font-semibold">{{ value }}</div>
    {% if caption %}
        <div class="text-sm {{ trend == 'up' ? 'text-green-600 dark:text-green-400' : (trend == 'down' ? 'text-red-600 dark:text-red-400' : 'text-gray-500 dark:text-gray-400') }}">
            {{ crud_icon(trend == 'flat' ? 'dash' : (trend == 'up' ? 'arrow-up-right' : 'arrow-down-right')) }} {{ caption }}
        </div>
    {% endif %}
</div>
