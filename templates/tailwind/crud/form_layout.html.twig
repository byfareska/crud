{#
    The form theme of the CRUD forms (and the filters of the lists) of this theme: Symfony's tailwind_2_layout with the
    classes of this theme. A theme of the application puts a template of this name into its directory to draw the
    fields otherwise.
#}
{% use 'tailwind_2_layout.html.twig' %}

{%- block form_row -%}
    {%- set row_class = row_class|default('mb-4') -%}
    {{- parent() -}}
{%- endblock form_row -%}

{%- block checkbox_row -%}
    {%- set row_class = row_class|default('mb-4') -%}
    {{- parent() -}}
{%- endblock checkbox_row -%}

{%- block widget_attributes -%}
    {%- set widget_class = widget_class|default('block w-full rounded-lg bg-white px-3 py-2 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 dark:bg-white/5 dark:text-white dark:outline-white/10 dark:placeholder:text-gray-500') -%}
    {%- set widget_disabled_class = widget_disabled_class|default('cursor-not-allowed opacity-60') -%}
    {%- set widget_errors_class = widget_errors_class|default('outline-red-500 dark:outline-red-400') -%}
    {%- if errors|length -%}{%- set attr = attr|merge({'aria-invalid': 'true'}) -%}{%- endif -%}
    {{- parent() -}}
{%- endblock widget_attributes -%}

{%- block checkbox_widget -%}
    {%- set widget_class = widget_class|default('me-2 size-4 accent-indigo-600') -%}
    {{- parent() -}}
{%- endblock checkbox_widget -%}

{%- block radio_widget -%}
    {%- set widget_class = widget_class|default('me-2 size-4 accent-indigo-600') -%}
    {{- parent() -}}
{%- endblock radio_widget -%}

{# The currency beside the amount, not above it. #}
{%- block money_widget -%}
    {%- set prepend = not (money_pattern starts with '{{') -%}
    {%- set append = not (money_pattern ends with '}}') -%}
    {%- if prepend or append -%}
        <div class="flex items-center gap-2">
            {%- if prepend -%}<span class="text-sm text-gray-500 dark:text-gray-400">{{ money_pattern|form_encode_currency }}</span>{%- endif -%}
            {{- block('form_widget_simple') -}}
            {%- if append -%}<span class="text-sm text-gray-500 dark:text-gray-400">{{ money_pattern|form_encode_currency }}</span>{%- endif -%}
        </div>
    {%- else -%}
        {{- block('form_widget_simple') -}}
    {%- endif -%}
{%- endblock money_widget -%}

{%- block form_label -%}
    {%- set label_class = label_class|default('mb-1 block text-sm font-medium text-gray-900 dark:text-gray-100') -%}
    {{- parent() -}}
{%- endblock form_label -%}

{%- block checkbox_label -%}
    {%- set label_class = label_class|default('text-sm text-gray-900 dark:text-gray-100') -%}
    {{- block('form_label') -}}
{%- endblock checkbox_label -%}

{%- block radio_label -%}
    {%- set label_class = label_class|default('text-sm text-gray-900 dark:text-gray-100') -%}
    {{- block('form_label') -}}
{%- endblock radio_label -%}

{%- block form_help -%}
    {%- set help_class = help_class|default('mt-1 text-sm text-gray-500 dark:text-gray-400') -%}
    {{- parent() -}}
{%- endblock form_help -%}

{%- block form_errors -%}
    {%- set error_item_class = error_item_class|default('mt-1 text-sm text-red-600 dark:text-red-400') -%}
    {{- parent() -}}
{%- endblock form_errors -%}

{#
    A field of files (CrudFileType): a hidden input with the JSON of its files, kept by the file-field controller -
    uploaded at once when chosen or dropped, picked in the window of the library, sorted by dragging, taken away. The
    files drawn here are those of the value; the controller draws a new one from the <template>.
#}
{%- block crud_file_widget -%}
    {%- set gallery = gallery and multiple -%}
    <div class="rounded-lg border border-dashed p-3 transition-colors data-[over]:border-indigo-500 data-[over]:bg-indigo-50 dark:data-[over]:bg-indigo-500/10 {{ errors|length ? 'border-red-500' : 'border-gray-300 dark:border-white/15' }}"
         data-controller="file-field"
         data-file-field-upload-url-value="{{ upload_url }}"
         data-file-field-token-value="{{ library_token }}"
         data-file-field-multiple-value="{{ multiple ? 'true' : 'false' }}"
         data-file-field-max-value="{{ max_files }}"
         data-action="dragover->file-field#over dragleave->file-field#leave drop->file-field#drop">
        <input type="hidden" id="{{ id }}" name="{{ full_name }}" value="{{ value }}" data-file-field-target="input"{% if disabled %} disabled{% endif %}>
        <ul class="{{ gallery ? 'grid grid-cols-[repeat(auto-fill,minmax(8rem,1fr))] gap-3' : 'flex flex-col gap-2' }} mb-3 empty:hidden"
            data-file-field-target="list"
            data-action="dragstart->file-field#dragStart dragover->file-field#dragOver drop->file-field#dropItem dragend->file-field#dragEnd">
            {%- for file in files -%}{{ block('crud_file_item') }}{%- endfor -%}
        </ul>
        <template data-file-field-target="template">{%- with {file: null} -%}{{ block('crud_file_item') }}{%- endwith -%}</template>
        {%- if not disabled -%}
        <div class="flex flex-wrap items-center gap-2">
            {%- if upload_url -%}
                <input type="file" class="hidden" accept="{{ accept }}"{% if multiple %} multiple{% endif %} data-file-field-target="picker" data-action="change->file-field#picked">
                <button type="button" class="rounded-lg bg-white px-2.5 py-1.5 text-sm font-semibold shadow-xs ring-1 ring-gray-300 ring-inset hover:bg-gray-50 disabled:opacity-50 dark:bg-white/10 dark:ring-white/10 dark:hover:bg-white/20" data-action="file-field#choose">{{ crud_icon('upload') }} {{ (multiple ? 'file.field.upload_many' : 'file.field.upload')|trans }}</button>
            {%- endif -%}
            {%- if library_token -%}
                <button type="button" class="rounded-lg bg-white px-2.5 py-1.5 text-sm font-semibold shadow-xs ring-1 ring-gray-300 ring-inset hover:bg-gray-50 disabled:opacity-50 dark:bg-white/10 dark:ring-white/10 dark:hover:bg-white/20" data-action="file-field#browse">{{ crud_icon('collection') }} {{ 'file.field.browse'|trans }}</button>
            {%- endif -%}
            {%- if upload_url -%}<span class="text-sm text-gray-500 dark:text-gray-400">{{ 'file.field.drop'|trans }}</span>{%- endif -%}
        </div>
        {%- endif -%}
    </div>
{%- endblock crud_file_widget -%}

{# A file of a field of files; "file" is null in the <template> a new one is drawn from. #}
{%- block crud_file_item -%}
    {%- set shown = file is not null and file.image and file.url -%}
    <li class="group relative {{ gallery ? 'flex flex-col gap-1' : 'flex items-center gap-3 rounded-lg bg-gray-50 p-2 dark:bg-white/5' }}"
        data-file-field-target="item" data-ref="{{ file.ref|default('') }}" data-sig="{{ file.sig|default('') }}"{% if multiple and not disabled %} draggable="true"{% endif %}>
        <a data-role="link" href="{{ file.url|default('#') }}" target="_blank" rel="noopener" class="{{ gallery ? 'block aspect-square overflow-hidden rounded-lg bg-gray-100 dark:bg-white/10' : 'flex size-10 shrink-0 items-center justify-center overflow-hidden rounded bg-gray-100 dark:bg-white/10' }}">
            <img data-role="image" src="{{ shown ? file.url : '' }}" alt="" loading="lazy" class="size-full object-cover"{% if not shown %} hidden{% endif %}>
            <span data-role="icon" class="flex size-full items-center justify-center text-2xl text-gray-400"{% if shown %} hidden{% endif %}>{{ crud_icon('file-earmark') }}</span>
        </a>
        <span data-role="name" class="min-w-0 flex-1 truncate text-sm" title="{{ file.name|default('') }}">{{ file.name|default('') }}</span>
        <progress data-role="progress" class="h-1.5 w-full accent-indigo-600" value="0" max="100" hidden></progress>
        <span data-role="error" class="text-xs text-red-600 dark:text-red-400" hidden></span>
        {%- for name in meta -%}
            <input type="text" class="block w-full rounded-md bg-white px-2 py-1 text-xs text-gray-900 outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:outline-indigo-600 dark:bg-white/5 dark:text-white dark:outline-white/10" data-meta="{{ name }}" value="{{ file.meta[name]|default('') }}" placeholder="{{ ('file.field.meta.' ~ name)|trans }}" aria-label="{{ ('file.field.meta.' ~ name)|trans }}" data-action="input->file-field#sync"{% if disabled %} disabled{% endif %}>
        {%- endfor -%}
        {%- if not disabled -%}
            <button type="button" class="{{ gallery ? 'absolute end-1 top-1 rounded-full bg-gray-900/70 p-1 text-white opacity-80 group-hover:opacity-100' : 'rounded-full p-1 text-gray-500 hover:bg-gray-100 dark:hover:bg-white/10' }} text-xs" data-action="file-field#remove" aria-label="{{ 'file.field.remove'|trans }}" title="{{ 'file.field.remove'|trans }}">{{ crud_icon('x-lg') }}</button>
        {%- endif -%}
    </li>
{%- endblock crud_file_item -%}

{# A field of rich text: its textarea, which the editor registered under "editor" draws over in the browser (the
   rich-text controller); a render of the live form leaves it alone, the editor writes the HTML back into it. #}
{%- block crud_rich_text_widget -%}
    {%- set attr = attr|merge({'data-rich-text-target': 'input'}) -%}
    <div id="{{ id }}_editor" data-live-ignore
         data-controller="rich-text"
         data-rich-text-editor-value="{{ editor }}"
         data-rich-text-options-value="{{ editor_options|json_encode }}"
         {%- if upload_url %} data-rich-text-upload-url-value="{{ upload_url }}"{% endif %}
         {%- if library_token %} data-rich-text-token-value="{{ library_token }}"{% endif %}
         {%- if image_token %} data-rich-text-image-token-value="{{ image_token }}"{% endif %}>
        {{- block('textarea_widget') -}}
    </div>
{%- endblock crud_rich_text_widget -%}
