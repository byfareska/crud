{# The panel the page is put into is the application's choice: byfareska_crud.scopes.<name>.layout. #}
{% extends layout %}

{% block page_title %}{{ crud.key(id is null ? 'new' : 'edit')|trans }} · {{ crud.key('title')|trans }}{% endblock %}

{% block content %}
    {# Crud:Form, or the resource's own form extending it (#[AsCrud] formComponent) - with its title row and the
       buttons next to it (block form_head), so the save buttons there are part of the form. #}
    {{ component(crud.formComponent, {resource: crud.name, id: id, tab: app.request.query.get('tab'), with: id is null ? app.request.query.all('with') : [], from: id is null ? app.request.query.get('from') : null}) }}
{% endblock %}
