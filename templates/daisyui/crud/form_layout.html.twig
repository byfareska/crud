{#
    The form theme of the CRUD forms (and the filters of the lists) of this theme: Symfony's daisyui_5_layout with the
    fields as wide as their row and the sizes of the panel. A theme of the application puts a template of this name
    into its directory to draw the fields otherwise.
#}
{% use 'daisyui_5_layout.html.twig' %}

{%- block form_row -%}
    {%- set row_class = row_class|default('mb-4 flex flex-col') -%}
    {{- parent() -}}
{%- endblock form_row -%}

{%- block checkbox_row -%}
    {%- set row_class = row_class|default('mb-4') -%}
    {{- parent() -}}
{%- endblock checkbox_row -%}

{%- block widget_attributes -%}
    {%- if errors|length -%}{%- set attr = attr|merge({'aria-invalid': 'true'}) -%}{%- endif -%}
    {{- parent() -}}
{%- endblock widget_attributes -%}

{% block form_widget_simple -%}
    {%- if type is not defined or type not in ['hidden', 'range', 'file'] %}
        {%- set widget_class = widget_class|default('input w-full') -%}
    {% endif -%}
    {{- parent() -}}
{%- endblock form_widget_simple %}

{# A select and a textarea as wide as their row (daisyui_5_layout gives them "mt-2" and no width). #}
{%- block choice_widget_collapsed -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' select w-full')|trim}) -%}
    {%- set widget_errors_class = 'select-error' -%}
    {%- if required and placeholder is none and not placeholder_in_choices and not multiple and (attr.size is not defined or attr.size <= 1) -%}
        {% set required = false %}
    {%- endif -%}
    <select {{ block('widget_attributes') }}{% if multiple %} multiple="multiple"{% endif %}>
        {%- if placeholder is not none -%}
            <option value=""{% if placeholder_attr|default({}) %}{% with {attr: placeholder_attr} %}{{ block('attributes') }}{% endwith %}{% endif %}{% if required and value is empty %} selected="selected"{% endif %}>{{ placeholder != '' ? (translation_domain is same as(false) ? placeholder : placeholder|trans({}, translation_domain)) }}</option>
        {%- endif -%}
        {%- if preferred_choices|length > 0 -%}
            {% set options = preferred_choices %}
            {% set render_preferred_choices = true %}
            {{- block('choice_widget_options') -}}
            {%- if choices|length > 0 and separator is not none -%}
                {%- if separator_html is not defined or separator_html is same as(false) -%}
                    <option disabled="disabled">{{ separator }}</option>
                {% else %}
                    {{ separator|raw }}
                {% endif %}
            {%- endif -%}
        {%- endif -%}
        {%- set options = choices -%}
        {%- set render_preferred_choices = false -%}
        {{- block('choice_widget_options') -}}
    </select>
{%- endblock choice_widget_collapsed -%}

{%- block textarea_widget -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' textarea w-full')|trim}) -%}
    {%- set widget_errors_class = 'textarea-error' -%}
    <textarea {{ block('widget_attributes') }}>{{ value }}</textarea>
{%- endblock textarea_widget -%}

{%- block file_widget -%}
    {%- set widget_class = widget_class|default('file-input w-full') -%}
    {{- parent() -}}
{%- endblock file_widget %}

{%- block choice_widget_expanded -%}
    <div {{ block('widget_container_attributes') }}>
        {%- for child in form %}
            <label class="mb-1 flex items-center gap-2 text-sm">
                {%- set child_attr = child.vars.help ? child.vars.attr|merge({'aria-describedby': child.vars.id ~ '_help'}) : child.vars.attr -%}
                {{- form_widget(child, {attr: child_attr}) -}}
                {%- if child.vars.label is not same as(false) -%}
                    {{- form_label(child, null, {translation_domain: choice_translation_domain, label_attr: {class: 'cursor-pointer'}, element: 'span'}) -}}
                {%- endif -%}
            </label>
            {{- form_help(child) -}}
        {% endfor -%}
    </div>
{%- endblock choice_widget_expanded -%}

{%- block checkbox_widget -%}
    {%- set widget_class = widget_class|default('checkbox checkbox-sm checkbox-primary') -%}
    {{- parent() -}}
{%- endblock checkbox_widget -%}

{%- block radio_widget -%}
    {%- set widget_class = widget_class|default('radio radio-sm radio-primary') -%}
    {{- parent() -}}
{%- endblock radio_widget -%}

{# The currency beside the amount, not above it. #}
{%- block money_widget -%}
    {%- set prepend = not (money_pattern starts with '{{') -%}
    {%- set append = not (money_pattern ends with '}}') -%}
    {%- if prepend or append -%}
        <label class="input w-full{{ errors|length ? ' input-error' }}">
            {%- if prepend -%}<span class="text-base-content/60">{{ money_pattern|form_encode_currency }}</span>{%- endif -%}
            {%- set widget_class = 'grow' -%}
            {%- set widget_errors_class = '' -%}
            {{- block('form_widget_simple') -}}
            {%- if append -%}<span class="text-base-content/60">{{ money_pattern|form_encode_currency }}</span>{%- endif -%}
        </label>
    {%- else -%}
        {{- block('form_widget_simple') -}}
    {%- endif -%}
{%- endblock money_widget -%}

{%- block form_label -%}
    {%- set label_class = label_class|default('label mb-1 text-sm font-medium text-base-content') -%}
    {{- parent() -}}
{%- endblock form_label -%}

{%- block form_help -%}
    {%- set help_attr = help_attr|merge({class: (help_attr.class|default('mt-1 text-sm text-base-content/60'))|trim}) -%}
    {{- parent() -}}
{%- endblock form_help -%}

{%- block form_errors -%}
    {%- set error_item_class = error_item_class|default('mt-1 text-sm text-error') -%}
    {{- parent() -}}
{%- endblock form_errors -%}

{#
    A field of files (CrudFileType): a hidden input with the JSON of its files, kept by the file-field controller -
    uploaded at once when chosen or dropped, picked in the window of the library, sorted by dragging, taken away. The
    files drawn here are those of the value; the controller draws a new one from the <template>.
#}
{%- block crud_file_widget -%}
    {%- set gallery = gallery and multiple -%}
    <div class="rounded-box border border-dashed border-base-300 p-3 transition-colors data-[over]:border-primary data-[over]:bg-primary/5{{ errors|length ? ' border-error' }}"
         data-controller="file-field"
         data-file-field-upload-url-value="{{ upload_url }}"
         data-file-field-token-value="{{ library_token }}"
         data-file-field-multiple-value="{{ multiple ? 'true' : 'false' }}"
         data-file-field-max-value="{{ max_files }}"
         data-action="dragover->file-field#over dragleave->file-field#leave drop->file-field#drop">
        <input type="hidden" id="{{ id }}" name="{{ full_name }}" value="{{ value }}" data-file-field-target="input"{% if disabled %} disabled{% endif %}>
        <ul class="{{ gallery ? 'grid grid-cols-[repeat(auto-fill,minmax(8rem,1fr))] gap-3' : 'flex flex-col gap-2' }} empty:hidden mb-3"
            data-file-field-target="list"
            data-action="dragstart->file-field#dragStart dragover->file-field#dragOver drop->file-field#dropItem dragend->file-field#dragEnd">
            {%- for file in files -%}{{ block('crud_file_item') }}{%- endfor -%}
        </ul>
        <template data-file-field-target="template">{%- with {file: null} -%}{{ block('crud_file_item') }}{%- endwith -%}</template>
        {%- if not disabled -%}
        <div class="flex flex-wrap items-center gap-2">
            {%- if upload_url -%}
                <input type="file" class="hidden" accept="{{ accept }}"{% if multiple %} multiple{% endif %} data-file-field-target="picker" data-action="change->file-field#picked">
                <button type="button" class="btn btn-sm" data-action="file-field#choose">{{ crud_icon('upload') }} {{ (multiple ? 'file.field.upload_many' : 'file.field.upload')|trans }}</button>
            {%- endif -%}
            {%- if library_token -%}
                <button type="button" class="btn btn-sm" data-action="file-field#browse">{{ crud_icon('collection') }} {{ 'file.field.browse'|trans }}</button>
            {%- endif -%}
            {%- if upload_url -%}<span class="text-sm text-base-content/60">{{ 'file.field.drop'|trans }}</span>{%- endif -%}
        </div>
        {%- endif -%}
    </div>
{%- endblock crud_file_widget -%}

{# A file of a field of files; "file" is null in the <template> a new one is drawn from. #}
{%- block crud_file_item -%}
    {%- set shown = file is not null and file.image and file.url -%}
    <li class="group relative {{ gallery ? 'flex flex-col gap-1' : 'flex items-center gap-3 rounded-box bg-base-200/50 p-2' }}"
        data-file-field-target="item" data-ref="{{ file.ref|default('') }}" data-sig="{{ file.sig|default('') }}"{% if multiple and not disabled %} draggable="true"{% endif %}>
        <a data-role="link" href="{{ file.url|default('#') }}" target="_blank" rel="noopener" class="{{ gallery ? 'block aspect-square overflow-hidden rounded-box bg-base-200' : 'flex size-10 shrink-0 items-center justify-center overflow-hidden rounded bg-base-200' }}">
            <img data-role="image" src="{{ shown ? file.preview|default(file.url) : '' }}" alt="" loading="lazy" class="size-full object-cover"{% if not shown %} hidden{% endif %}>
            <span data-role="icon" class="flex size-full items-center justify-center text-2xl text-base-content/50"{% if shown %} hidden{% endif %}>{{ crud_icon('file-earmark') }}</span>
        </a>
        <span data-role="name" class="min-w-0 flex-1 truncate text-sm" title="{{ file.name|default('') }}">{{ file.name|default('') }}</span>
        <progress data-role="progress" class="progress progress-primary w-full" value="0" max="100" hidden></progress>
        <span data-role="error" class="text-xs text-error" hidden></span>
        {%- for name in meta -%}
            <input type="text" class="input input-xs w-full" data-meta="{{ name }}" value="{{ file.meta[name]|default('') }}" placeholder="{{ ('file.field.meta.' ~ name)|trans }}" aria-label="{{ ('file.field.meta.' ~ name)|trans }}" data-action="input->file-field#sync"{% if disabled %} disabled{% endif %}>
        {%- endfor -%}
        {%- if not disabled -%}
            <button type="button" class="btn btn-circle btn-xs {{ gallery ? 'absolute end-1 top-1 btn-neutral opacity-80 group-hover:opacity-100' : 'btn-ghost' }}" data-action="file-field#remove" aria-label="{{ 'file.field.remove'|trans }}" title="{{ 'file.field.remove'|trans }}">{{ crud_icon('x-lg') }}</button>
        {%- endif -%}
    </li>
{%- endblock crud_file_item -%}

{# A field of rich text: its textarea, which the editor registered under "editor" draws over in the browser (the
   rich-text controller); a render of the live form leaves it alone, the editor writes the HTML back into it. #}
{%- block crud_rich_text_widget -%}
    {%- set attr = attr|merge({'data-rich-text-target': 'input'}) -%}
    <div id="{{ id }}_editor" data-live-ignore
         data-controller="rich-text"
         data-rich-text-editor-value="{{ editor }}"
         data-rich-text-options-value="{{ editor_options|json_encode }}"
         {%- if upload_url %} data-rich-text-upload-url-value="{{ upload_url }}"{% endif %}
         {%- if library_token %} data-rich-text-token-value="{{ library_token }}"{% endif %}
         {%- if image_token %} data-rich-text-image-token-value="{{ image_token }}"{% endif %}
         {%- if sizes %} data-rich-text-sizes-value="{{ sizes|json_encode }}"{% endif %}>
        {{- block('textarea_widget') -}}
    </div>
{%- endblock crud_rich_text_widget -%}
