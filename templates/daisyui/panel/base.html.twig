{#
    Every page of the panel. Tailwind CSS (v4) with daisyUI (v5) and Bootstrap Icons come with the application's
    assets (panel/_assets.html.twig), built with @source on this directory and the colour themes of
    byfareska_crud.color_themes:

        @import 'tailwindcss';
        @plugin 'daisyui' { themes: all; }
        @source '../vendor/byfareska/crud/templates/daisyui';

    The colour theme is data-theme on <html>, picked in the top bar (Panel:ThemeToggle) and remembered in the browser.
#}
<!DOCTYPE html>
<html lang="{{ app.locale|replace({"_": "-"}) }}" dir="{{ panel_dir(app.locale) }}" data-theme="light" class="h-full">
    <head>
        <meta charset="UTF-8">
        {# The colour theme chosen before (theme controller) - else light or dark as the system is - set before the
           first paint. A theme of yours changes the key it is remembered under (theme_storage_key, as
           data-theme-storage-key-value of the controller) or gives the script a nonce of a Content Security Policy
           (theme_script_attributes: ` nonce="{{ csp_nonce('script') }}"`). #}
        {% set color_themes = crud_color_themes() %}
        {# Defined here, drawn only where they are asked for (block()). #}
        {% if false %}{% block theme_storage_key %}panel-theme-daisyui{% endblock %}{% block theme_script_attributes %}{% endblock %}{% block theme_dark_schemes %}{{ color_themes.dark|json_encode|raw }}{% endblock %}{% endif %}
        {% block theme_script %}
        <script{{ block('theme_script_attributes') }}>
            (function () {
                var theme = null;
                try { theme = localStorage.getItem({{ block('theme_storage_key')|trim|json_encode|raw }}); } catch (e) {}
                // A theme no longer offered (byfareska_crud.color_themes) is forgotten: light or dark as the system is.
                if ({{ color_themes.names|json_encode|raw }}.indexOf(theme) < 0) {
                    theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
                }
                document.documentElement.setAttribute('data-theme', theme);
                var dark = {{ block('theme_dark_schemes')|trim|raw }}.indexOf(theme) >= 0 ? 'dark' : 'light';
                document.documentElement.setAttribute('data-color-scheme', dark);
                document.documentElement.style.colorScheme = dark;
            })();
        </script>
        {% endblock %}
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
        <meta name="turbo-prefetch" content="false">
        <title>{% block title %}{{ panel_brand() }}{% endblock %}</title>
        {% block assets %}{{ include('@CrudTheme/panel/_assets.html.twig') }}{% endblock %}
    </head>
    {# data-scope: the panel of the page, for the command palette (kept across Turbo visits) - in any layout extending this one. #}
    <body class="{% block body_class %}min-h-full bg-base-200 text-base-content antialiased{% endblock %}" data-scope="{{ panel_scope().name }}">
        {% block body %}{% endblock %}
    </body>
</html>
