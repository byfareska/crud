{# A compact list of a widget. items: {title, meta?, time?, href?, icon?, accent?, avatar?: {name, src}, badge?}. #}
{% props items = [], empty = null %}
{% if items is empty %}
    <div class="text-sm text-base-content/60">{{ empty }}</div>
{% else %}
    <ul {{ attributes.defaults({class: 'flex flex-col gap-0.5'}) }}>
        {% for item in items %}
            <li>
                {% set tag = item.href is defined and item.href ? 'a' : 'div' %}
                <{{ tag }} class="flex items-center gap-2 rounded-field px-1 py-1 text-sm{{ tag == 'a' ? ' hover:bg-base-200' }}"{% if tag == 'a' %} href="{{ item.href }}"{% endif %}>
                    {% if item.avatar is defined and item.avatar %}
                        <twig:Ui:Avatar :name="item.avatar.name" :src="item.avatar.src ?? null" size="1.75rem" />
                    {% elseif item.icon is defined and item.icon %}
                        {{ crud_icon(item.icon, '', {style: 'color: ' ~ (item.accent ?? 'inherit')}) }}
                    {% endif %}
                    <span class="min-w-0 flex-1 truncate">
                        {{ item.title }}
                        {% if item.meta is defined and item.meta %}<span class="block truncate text-xs text-base-content/60">{{ item.meta }}</span>{% endif %}
                    </span>
                    {% if item.badge is defined and item.badge is not null %}<span class="badge badge-sm badge-ghost">{{ item.badge }}</span>{% endif %}
                    {% if item.time is defined and item.time %}<span class="text-xs whitespace-nowrap text-base-content/60">{{ item.time }}</span>{% endif %}
                </{{ tag }}>
            </li>
        {% endfor %}
    </ul>
{% endif %}
