{#
    Pager for a live component: every control writes the page number to the parent's `model` LiveProp. Between the
    arrows there are at most seven places: more pages collapse to first / neighbours / last; the last gap is a "jump to
    page" field (not bound with data-model: the component would write the current page into it). Using it scrolls the
    closest ancestor matching `scrollTo` into view.
#}
{% props page, pageCount, model = 'page', scrollTo = '[data-scroll-anchor]' %}
{% set gapOnRight = pageCount > 7 and page < pageCount - 3 %}
{% if pageCount <= 7 %}
    {% set items = pageCount > 0 ? 1..pageCount : [] %}
{% elseif page <= 4 %}
    {% set items = (1..5)|merge(['gap', pageCount]) %}
{% elseif not gapOnRight %}
    {% set items = [1, 'gap']|merge((pageCount - 4)..pageCount) %}
{% else %}
    {% set items = [1, 'gap', page - 1, page, page + 1, 'gap', pageCount] %}
{% endif %}
{% set cell = 'join-item btn btn-sm min-w-8 px-2' %}
{% set link = cell %}
<ul {{ attributes.defaults({
    class: 'join',
    'data-controller': 'scroll-to',
    'data-scroll-to-selector-value': scrollTo,
    'data-action': 'click->scroll-to#scroll live-set:set->scroll-to#scroll',
}) }}>
    <li class="contents">
        <button type="button" class="{{ link }}" title="{{ 'ui.pagination.previous_tip'|trans }}" aria-label="{{ 'ui.pagination.previous'|trans }}" data-action="live#update" data-model="{{ model }}" data-value="{{ page - 1 }}"{{ page <= 1 ? ' disabled' }}>{{ crud_icon('chevron-left') }}</button>
    </li>
    {% for item in items %}
        <li class="contents">
            {% if item == 'gap' %}
                {% if loop.revindex == 2 or not gapOnRight %}
                    <input class="join-item input input-sm w-14 text-center" type="number" min="1" max="{{ pageCount }}" placeholder="…" aria-label="{{ 'ui.pagination.jump'|trans }}" title="{{ 'ui.pagination.jump_hint'|trans }}" id="{{ model }}-jump" data-controller="live-set" data-live-set-model-value="{{ model }}" data-action="input->live-set#later change->live-set#now">
                {% else %}
                    <span class="{{ cell }} btn-disabled">…</span>
                {% endif %}
            {% else %}
                <button type="button" class="{{ link }}{{ item == page ? ' btn-active btn-primary' }}"{% if item == page %} aria-current="page"{% endif %} data-action="live#update" data-model="{{ model }}" data-value="{{ item }}">{{ item }}</button>
            {% endif %}
        </li>
    {% endfor %}
    <li class="contents">
        <button type="button" class="{{ link }}" title="{{ 'ui.pagination.next_tip'|trans }}" aria-label="{{ 'ui.pagination.next'|trans }}" data-action="live#update" data-model="{{ model }}" data-value="{{ page + 1 }}"{{ page >= pageCount ? ' disabled' }}>{{ crud_icon('chevron-right') }}</button>
    </li>
</ul>
