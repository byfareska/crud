{# The title row of a page. Buttons go into the "actions" block. #}
{% props title, meta = null, subtitle = null %}
{% set actions %}{% block actions %}{% endblock %}{% endset %}
<div {{ attributes.defaults({class: 'mb-6 flex flex-wrap items-center gap-3'}) }}>
    <div class="me-auto">
        <h1 class="text-2xl font-semibold tracking-tight">{{ title }}{% if meta %} <small class="text-base font-normal text-base-content/60">{{ meta }}</small>{% endif %}</h1>
        {% if subtitle %}<p class="text-sm text-base-content/60">{{ subtitle }}</p>{% endif %}
    </div>
    {% if actions|trim is not empty %}
        <div class="flex flex-wrap items-center gap-2">{{ actions }}</div>
    {% endif %}
</div>
